---
import "../styles/global.css";
const { title = "AI Workflow Toolkit | Reliable workflows for agencies", description = "Design safer business automations with structured workflow blueprints, safeguards, test plans and n8n starter exports.", canonical = "https://ai-workflow-toolkit.pages.dev" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0d14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical + Astro.url.pathname} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical + Astro.url.pathname} />
    <meta property="og:site_name" content="AI Workflow Toolkit" />
    <meta property="og:image" content="https://ai-workflow-toolkit.pages.dev/og-image.svg" />
    <meta name="twitter:image" content="https://ai-workflow-toolkit.pages.dev/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/" aria-label="AI Workflow Toolkit home"><span class="brand-mark">A</span><span>AI Workflow Toolkit</span></a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/builder/">Builder</a>
          <a href="/ai-builder/" class="hide-small">AI Generator</a>
          <a href="/templates/" class="hide-small">Templates</a>
          <a href="/guides/" class="hide-small">Guides</a>
          <a href="/pricing/" class="hide-small">Pricing</a>
        </nav>
        <a class="nav-cta" href="/builder/">Build a workflow <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <a class="brand" href="/"><span class="brand-mark">A</span><span>AI Workflow Toolkit</span></a>
        <span>Practical systems for better client work.</span>
        <div class="footer-links"><a href="/sample/">Sample</a><a href="/services/">Services</a><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/refunds/">Refunds</a><a href="https://github.com/piyushnath227/ai-workflow-toolkit" target="_blank" rel="noreferrer">GitHub ↗</a></div>
      </div>
    </footer>
  </body>
</html>
