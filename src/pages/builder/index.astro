---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Free AI Workflow Builder | AI Workflow Toolkit" description="Turn a business process into a structured automation plan, visual workflow, test checklist and downloadable JSON—free, with no API key.">
  <div class="builder-shell">
    <div class="builder-heading">
      <div><span class="eyebrow">Workflow studio · Free · No API key</span><h1>From messy process to <span class="gradient">clear workflow.</span></h1><p>Describe the work you want to improve. Get a practical automation blueprint with steps, decision points, failure handling and a test plan.</p></div>
      <div class="builder-status"><span class="status-dot"></span> Runs locally in your browser</div>
    </div>
    <div class="builder-layout">
      <form class="panel builder-form" id="workflow-form">
        <div class="form-title"><span class="step-number">01</span><div><h2>Describe your process</h2><p>Give the builder enough context to create a useful first draft.</p></div></div>
        <label class="field"><span>What do you want to automate?</span><textarea id="goal" rows="4" maxlength="700" required placeholder="When a new client signs a proposal, create their project, send a welcome email, request assets, and alert the account manager if anything is missing."></textarea><small>Be specific about the trigger, actions and desired result.</small></label>
        <div class="field"><label for="workflow-type">Closest workflow type</label><select id="workflow-type"><option value="client">Client onboarding</option><option value="leads">Lead capture & follow-up</option><option value="content">Content production</option><option value="support">Customer support triage</option><option value="reporting">Weekly reporting</option><option value="custom">General business process</option></select></div>
        <div class="field"><label for="stack">Tools you use</label><select id="stack"><option value="generic">Not decided yet</option><option value="google">Google Workspace / Sheets</option><option value="microsoft">Microsoft 365</option><option value="crm">CRM (HubSpot or similar)</option><option value="project">Project tool (Trello, Asana or similar)</option><option value="webhook">APIs / webhooks</option></select></div>
        <div class="field"><label for="risk">Automation level</label><select id="risk"><option value="human">Human approval before important actions</option><option value="balanced">Automate routine steps, escalate exceptions</option><option value="full">Automate wherever safe</option></select></div>
        <button class="btn btn-primary builder-submit" type="submit">Build my workflow <span>↗</span></button>
        <p class="notice">No account or API key needed. This tool creates a local blueprint; it does not connect to or execute actions in your business apps.</p>
      </form>
      <section class="panel builder-output" id="output-panel" aria-live="polite">
        <div class="output-toolbar"><div><span class="eyebrow">Your blueprint</span><h2 id="output-title">Workflow preview</h2></div><span class="pill" id="output-count">Awaiting input</span></div>
        <p class="muted output-summary" id="output-summary">Your workflow map, implementation plan and testing checklist will appear here.</p>
        <div class="output-placeholder" id="placeholder"><div class="placeholder-symbol">⌘</div><strong>A process you can actually build.</strong><span>Start with a real task on the left. We'll turn it into a structured, editable plan.</span></div>
        <div id="generated" hidden>
          <div class="tab-bar" role="tablist" aria-label="Workflow output">
            <button class="tab active" type="button" data-tab="map" role="tab" aria-selected="true">Workflow map</button>
            <button class="tab" type="button" data-tab="plan" role="tab" aria-selected="false">Build plan</button>
            <button class="tab" type="button" data-tab="tests" role="tab" aria-selected="false">Test checklist</button>
          </div>
          <div id="map-view" class="tab-view"></div>
          <div id="plan-view" class="tab-view" hidden></div>
          <div id="tests-view" class="tab-view" hidden></div>
          <div class="export-bar"><div><strong>Take it with you</strong><small>Download the blueprint or copy a build-ready brief.</small></div><div class="export-actions"><button type="button" class="btn btn-secondary" id="copy-plan">Copy plan</button><button type="button" class="btn btn-primary" id="download-json">Download JSON ↗</button><button type="button" class="btn btn-secondary" id="download-md">Download .md</button></div></div>
          <p class="success" id="feedback" role="status"></p>
        </div>
      </section>
    </div>
    <div class="builder-footnote"><span>01 / Define</span><span>02 / Map</span><span>03 / Validate</span><span>04 / Implement in your chosen tools</span></div>
  </div>
  <script>
    const form = document.querySelector("#workflow-form");
    const generated = document.querySelector("#generated");
    const placeholder = document.querySelector("#placeholder");
    const feedback = document.querySelector("#feedback");
    let blueprint = null;

    const templates = {
      client: {
        name: "Client onboarding",
        trigger: "A proposal is accepted or a new client is marked as won.",
        steps: [
          ["Capture client details", "Create a single client record with contact, scope, start date and owner.", "Input"],
          ["Validate required information", "Check that email, scope, owner and start date are present.", "Decision"],
          ["Create project workspace", "Use a standard project template and assign an accountable owner.", "Action"],
          ["Send welcome and intake request", "Send approved welcome copy and a secure link for required assets.", "Action"],
          ["Notify the account owner", "Share the new project link, due dates and any missing information.", "Action"],
          ["Confirm onboarding is ready", "Mark ready only when required fields and access requests are resolved.", "Verify"]
        ],
        risks: ["Duplicate client or project created after a repeated trigger.", "Client email fails or is sent to the wrong contact.", "Sensitive credentials are requested in plain text."]
      },
      leads: {
        name: "Lead capture & follow-up",
        trigger: "A new lead submits a form or enters the CRM.",
        steps: [
          ["Capture lead and source", "Store contact details, consent status, source and submission timestamp.", "Input"],
          ["Validate and deduplicate", "Check required fields, consent and existing contact records.", "Decision"],
          ["Route lead to an owner", "Assign by territory, service or a defined round-robin rule.", "Action"],
          ["Send relevant acknowledgement", "Send an approved confirmation only when contact permission allows it.", "Action"],
          ["Create follow-up task", "Set an owner and due date based on lead priority.", "Action"],
          ["Check response SLA", "If no follow-up occurs by the deadline, alert the owner or manager.", "Verify"]
        ],
        risks: ["Duplicate leads create repeated messages.", "Consent is missing or unclear.", "No owner is available or the CRM is unavailable."]
      },
      content: {
        name: "Content production",
        trigger: "A content request is submitted or a new item is added to the editorial backlog.",
        steps: [
          ["Capture content brief", "Collect channel, audience, goal, format, deadline and source material.", "Input"],
          ["Check brief completeness", "Route missing audience, goal or deadline back to the requester.", "Decision"],
          ["Create draft task", "Add the brief to the editorial board with an owner and due date.", "Action"],
          ["Prepare draft for review", "Use the approved template and link source material.", "Action"],
          ["Request human review", "Collect editorial, brand and factual checks before publishing.", "Approval"],
          ["Publish or schedule after approval", "Only approved content can proceed; record the final destination.", "Verify"]
        ],
        risks: ["Incomplete brief causes rework.", "Unverified claims or rights issues reach publication.", "Content is published without required approval."]
      },
      support: {
        name: "Customer support triage",
        trigger: "A new support email or ticket arrives.",
        steps: [
          ["Capture ticket and context", "Record customer, issue, timestamp, channel and relevant history.", "Input"],
          ["Classify and assess urgency", "Use clear rules for topic, severity and business impact.", "Decision"],
          ["Route to the correct queue", "Assign a trained owner and attach relevant troubleshooting steps.", "Action"],
          ["Acknowledge receipt", "Send a neutral acknowledgement without promising an unverified resolution.", "Action"],
          ["Escalate high-risk cases", "Send security, payment or safety-sensitive issues to a human immediately.", "Approval"],
          ["Verify resolution and close", "Close only after required confirmation or a documented closure rule.", "Verify"]
        ],
        risks: ["Misclassification delays a critical case.", "Sensitive personal information appears in notifications.", "Automated replies make unsupported promises."]
      },
      reporting: {
        name: "Weekly reporting",
        trigger: "A scheduled weekly run begins.",
        steps: [
          ["Collect approved data sources", "Fetch the defined metrics for the reporting period.", "Input"],
          ["Validate freshness and completeness", "Check expected date range, missing values and source availability.", "Decision"],
          ["Calculate agreed metrics", "Apply documented definitions and compare with the prior period.", "Action"],
          ["Draft report with source links", "Summarize changes and flag missing or anomalous data.", "Action"],
          ["Review unusual results", "Ask an owner to verify unexpected changes before distribution.", "Approval"],
          ["Distribute and archive", "Send to the approved audience and store a dated copy.", "Verify"]
        ],
        risks: ["A source is stale or incomplete.", "Metric definitions change without notice.", "An unreviewed anomaly is presented as fact."]
      },
      custom: {
        name: "Business process",
        trigger: "A clearly defined business event occurs.",
        steps: [
          ["Capture the triggering event", "Record the event, source, timestamp and unique reference.", "Input"],
          ["Validate required data", "Check required fields and stop safely if information is missing.", "Decision"],
          ["Perform the primary action", "Run the smallest repeatable action that advances the process.", "Action"],
          ["Record the outcome", "Store status, owner, timestamp and a traceable reference.", "Action"],
          ["Handle exceptions", "Retry temporary failures safely and route unresolved issues to a person.", "Recovery"],
          ["Verify completion", "Check the expected result rather than trusting a success response alone.", "Verify"]
        ],
        risks: ["The trigger fires more than once.", "A downstream service fails partway through.", "The action succeeds but the status record does not update."]
      }
    };

    const toolNotes = {
      generic: "Choose tools already approved by your team. Start with a spreadsheet or project board if integrations are not ready.",
      google: "Possible mapping: Google Forms or Gmail → Apps Script or automation platform → Sheets → Gmail / Google Tasks. Confirm OAuth scopes and sharing permissions.",
      microsoft: "Possible mapping: Microsoft Forms or Outlook → Power Automate → Lists / Planner → Outlook or Teams. Confirm tenant policies and connector licensing.",
      crm: "Possible mapping: CRM form/event → workflow automation → CRM record and task → approved email provider. Use the CRM's native duplicate and consent rules where available.",
      project: "Possible mapping: form or webhook → automation platform → project board template → owner notification. Confirm board permissions and task idempotency.",
      webhook: "Possible mapping: event source → authenticated webhook → validated payload → API action → result check. Use HTTPS, secret storage, signature verification and request IDs."
    };
    const typeNames = { Input: "Trigger / input", Decision: "Decision", Action: "Action", Approval: "Human approval", Recovery: "Recovery", Verify: "Verification" };
    const safe = (value) => String(value).replace(/[&<>"']/g, char => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char]));
    function createBlueprint() {
      const goal = document.querySelector("#goal").value.trim();
      const type = document.querySelector("#workflow-type").value;
      const stack = document.querySelector("#stack").value;
      const risk = document.querySelector("#risk").value;
      const template = templates[type];
      const steps = template.steps.map((step, index) => ({ id: index + 1, title: step[0], description: step[1], type: step[2], owner: step[2] === "Approval" || (risk === "human" && step[2] === "Action" && index === 4) ? "Human owner" : "Automation / configured tool" }));
      const humanGate = risk === "human" ? "Pause before sending external communications, changing records, or making irreversible changes until an authorized person approves." : risk === "balanced" ? "Automate standard cases, but send missing data, low-confidence classifications and repeated failures to a named human owner." : "Automate only reversible, low-risk steps; retain human approval for sensitive, financial, legal, security or irreversible actions.";
      return {
        product: "AI Workflow Toolkit",
        version: "1.0",
        generatedAt: new Date().toISOString(),
        title: template.name,
        userGoal: goal,
        workflowType: type,
        trigger: template.trigger,
        selectedTools: stack,
        suggestedToolMapping: toolNotes[stack],
        automationMode: risk,
        approvalPolicy: humanGate,
        steps,
        decisionRules: ["If required input is missing, stop the run and request the missing fields.", "If a matching event ID or record already exists, do not repeat non-idempotent actions.", "If an action fails, record the step and error; retry only transient failures with a bounded retry policy.", "If the result cannot be verified, mark the run as needs-review instead of complete."],
        failureHandling: template.risks,
        implementationPlan: [
          "Write down the exact trigger and one measurable definition of success.",
          "Map each step to a real app, connector or API; confirm permissions before connecting anything.",
          "Create a test workspace and use synthetic data before touching live client records.",
          "Add a unique run ID, duplicate-event guard, step status and timestamps.",
          "Configure bounded retries for transient errors and a human-owned exception queue.",
          "Add a final verification step and a safe way to pause or disable the workflow."
        ],
        tests: [
          ["Happy path", "A complete, valid event reaches the expected final state."],
          ["Missing data", "A required field is absent; the run pauses and clearly identifies it."],
          ["Duplicate trigger", "The same event is replayed; no duplicate email, project or payment occurs."],
          ["Integration failure", "A downstream service fails; the error is logged and retry behavior is bounded."],
          ["Approval gate", "A protected action cannot proceed until an authorized human approves."],
          ["Verification mismatch", "An action reports success but the target state is missing; the run is flagged."],
          ["Privacy and access", "Only minimum necessary data is stored and permissions match the intended role."]
        ],
        monitoring: ["Run status and duration", "Per-step errors and retry count", "Items waiting for human review", "Duplicate events prevented", "Success rate over time"],
        limitations: "This is a generated design blueprint, not an executable integration. Verify app capabilities, API behavior, security requirements and current pricing before implementation."
      };
    }
    function renderMap(bp) {
      const container = document.querySelector("#map-view");
      container.innerHTML = '<div class="workflow-map"><div class="map-start"><span class="node-kicker">TRIGGER</span><strong>' + safe(bp.trigger) + '</strong></div>' +
        bp.steps.map((step, i) => '<div class="map-connector" aria-hidden="true"><span>↓</span></div><article class="workflow-node node-' + step.type.toLowerCase() + '"><div class="node-top"><span class="node-index">' + String(i + 1).padStart(2,"0") + '</span><span class="node-kind">' + safe(typeNames[step.type] || step.type) + '</span></div><strong>' + safe(step.title) + '</strong><p>' + safe(step.description) + '</p></article>' + (step.type === "Decision" ? '<div class="branch-note"><span>IF NO / INVALID</span> Pause and request missing information; do not continue.</div>' : '')).join("") +
        '<div class="map-connector" aria-hidden="true"><span>↓</span></div><div class="map-end"><span>✓</span><strong>Verify outcome & record run</strong><small>Complete only when the expected result is confirmed.</small></div></div>';
    }
    function renderPlan(bp) {
      document.querySelector("#plan-view").innerHTML =
        '<div class="plan-block"><span class="eyebrow">Trigger</span><h3>' + safe(bp.trigger) + '</h3><p>' + safe(bp.userGoal) + '</p></div>' +
        '<div class="plan-block"><span class="eyebrow">Suggested implementation</span><h3>Tool mapping</h3><p>' + safe(bp.suggestedToolMapping) + '</p></div>' +
        '<div class="plan-block"><span class="eyebrow">Execution steps</span><ol class="build-steps">' + bp.steps.map(s => '<li><strong>' + safe(s.title) + '</strong><p>' + safe(s.description) + '</p><small>Suggested owner: ' + safe(s.owner) + '</small></li>').join("") + '</ol></div>' +
        '<div class="plan-block"><span class="eyebrow">Safety & recovery</span><h3>Approval policy</h3><p>' + safe(bp.approvalPolicy) + '</p><ul>' + bp.decisionRules.map(x => '<li>' + safe(x) + '</li>').join("") + '</ul></div>' +
        '<div class="plan-block"><span class="eyebrow">Known failure modes</span><ul>' + bp.failureHandling.map(x => '<li>' + safe(x) + '</li>').join("") + '</ul></div>' +
        '<div class="plan-block"><span class="eyebrow">Build sequence</span><ol>' + bp.implementationPlan.map(x => '<li>' + safe(x) + '</li>').join("") + '</ol></div>' +
        '<div class="plan-block"><span class="eyebrow">Observability</span><ul>' + bp.monitoring.map(x => '<li>' + safe(x) + '</li>').join("") + '</ul></div>' +
        '<p class="notice">' + safe(bp.limitations) + '</p>';
    }
    function renderTests(bp) {
      document.querySelector("#tests-view").innerHTML = '<div class="test-intro"><strong>Test before connecting live accounts.</strong><p>Mark each scenario as you verify it in a sandbox or test workspace. This checklist is a planning aid, not proof the workflow passed.</p></div><div class="test-list">' +
        bp.tests.map((test,i) => '<label class="test-row"><input type="checkbox"><span><strong>' + safe(test[0]) + '</strong><small>' + safe(test[1]) + '</small></span></label>').join("") + '</div>';
    }
    function toMarkdown(bp) {
      return '# ' + bp.title + ' workflow blueprint\n\n> Generated locally by AI Workflow Toolkit. This is a plan, not an executing integration.\n\n## Goal\n' + bp.userGoal + '\n\n## Trigger\n' + bp.trigger + '\n\n## Suggested tools\n' + bp.suggestedToolMapping + '\n\n## Workflow steps\n' + bp.steps.map(s => (s.id + '. **' + s.title + '** (' + s.type + ')\n   - ' + s.description + '\n   - Owner: ' + s.owner)).join('\n') + '\n\n## Decision and recovery rules\n' + bp.decisionRules.map(x => '- ' + x).join('\n') + '\n\n## Failure modes to plan for\n' + bp.failureHandling.map(x => '- ' + x).join('\n') + '\n\n## Implementation plan\n' + bp.implementationPlan.map((x,i) => (i+1) + '. ' + x).join('\n') + '\n\n## Test checklist\n' + bp.tests.map(t => '- [ ] **' + t[0] + ':** ' + t[1]).join('\n') + '\n\n## Monitoring\n' + bp.monitoring.map(x => '- ' + x).join('\n') + '\n\n## Approval policy\n' + bp.approvalPolicy + '\n\n## Limitations\n' + bp.limitations + '\n';
    }
    function downloadFile(filename, content, type) {
      const blob = new Blob([content], {type});
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = filename; document.body.append(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }
    form.addEventListener("submit", event => {
      event.preventDefault();
      blueprint = createBlueprint();
      document.querySelector("#output-title").textContent = blueprint.title;
      document.querySelector("#output-count").textContent = blueprint.steps.length + " steps · " + blueprint.tests.length + " tests";
      document.querySelector("#output-summary").textContent = "A practical first draft based on your goal, tool preference and chosen approval level.";
      placeholder.hidden = true; generated.hidden = false;
      renderMap(blueprint); renderPlan(blueprint); renderTests(blueprint);
      document.querySelectorAll(".tab").forEach(tab => {tab.classList.toggle("active", tab.dataset.tab === "map"); tab.setAttribute("aria-selected", String(tab.dataset.tab === "map"));});
      document.querySelectorAll(".tab-view").forEach(view => view.hidden = view.id !== "map-view");
      feedback.textContent = "";
    });
    document.querySelectorAll(".tab").forEach(tab => tab.addEventListener("click", () => {
      document.querySelectorAll(".tab").forEach(t => {t.classList.toggle("active", t === tab); t.setAttribute("aria-selected", String(t === tab));});
      document.querySelectorAll(".tab-view").forEach(view => view.hidden = view.id !== tab.dataset.tab + "-view");
    }));
    document.querySelector("#copy-plan").addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(toMarkdown(blueprint)); feedback.textContent = "Build plan copied to clipboard."; }
      catch { feedback.textContent = "Clipboard access was blocked. Use Download .md instead."; }
    });
    document.querySelector("#download-json").addEventListener("click", () => {downloadFile("workflow-blueprint.json", JSON.stringify(blueprint, null, 2), "application/json;charset=utf-8"); feedback.textContent = "JSON blueprint downloaded.";});
    document.querySelector("#download-md").addEventListener("click", () => {downloadFile("workflow-blueprint.md", toMarkdown(blueprint), "text/markdown;charset=utf-8"); feedback.textContent = "Markdown build plan downloaded.";});
  </script>
</BaseLayout>
