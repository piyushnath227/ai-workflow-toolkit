---
import BaseLayout from "../../layouts/BaseLayout.astro";
const guides = [
  {tag:"Client operations · 6 min",title:"How to build a client onboarding process that scales",description:"Create a repeatable welcome, access, kickoff and approval process without making every project feel rigid.",href:"/guides/client-onboarding-process/"},
  {tag:"Automation basics · 7 min",title:"Find your first workflow to automate",description:"A practical way to spot repetitive work, estimate its value and avoid automating a broken process.",href:"/guides/first-workflow-to-automate/"},
  {tag:"AI workflows · 8 min",title:"A safer way to add AI to business workflows",description:"Use AI for bounded tasks while keeping permissions, verification and human approval where they matter.",href:"/guides/safer-ai-workflows/"},
  {tag:"Client operations · 5 min",title:"Client onboarding automation for small agencies",description:"A practical blueprint for intake validation, project setup, welcome messages and verified handoff.",href:"/guides/client-onboarding-automation/"},
  {tag:"Sales automation · 6 min",title:"Lead follow-up automation: a safer starter workflow",description:"Route leads while checking required data, consent and duplicate submissions.",href:"/guides/lead-follow-up-automation/"},
  {tag:"Testing · 6 min",title:"How to test an automation before production",description:"A repeatable checklist for happy paths, duplicates, bad inputs and provider failures.",href:"/guides/workflow-testing/"},
  {tag:"Reliability · 6 min",title:"n8n error handling: retries, alerts and recovery",description:"Plan recoverable failures instead of letting automation silently stop.",href:"/guides/n8n-error-handling/"},
  {tag:"Reliability · 5 min",title:"Prevent duplicate runs with idempotency keys",description:"Use stable event IDs to prevent repeated webhooks from creating duplicate side effects.",href:"/guides/preventing-duplicate-workflows/"},
  {tag:"Governance · 6 min",title:"When an automation should ask a human for approval",description:"Use explicit approval gates for external messages, publishing and irreversible changes.",href:"/guides/human-approval-workflows/"},
  {tag:"Reporting · 6 min",title:"Weekly client reporting automation for agencies",description:"Build reporting with source freshness checks and review before distribution.",href:"/guides/weekly-client-report-automation/"},
];
---
<BaseLayout title="Automation Guides for Small Teams | AI Workflow Toolkit" description="Practical workflow and automation guides for consultants and small agencies.">
  <div class="wrap"><div class="page-hero"><span class="eyebrow">The field guide</span><h1>Better systems, <span class="gradient">one practical step at a time.</span></h1><p>Useful, approachable playbooks for making client delivery more consistent. Start simple, measure what changes, then improve.</p></div>
  <div class="guide-grid">{guides.map((guide)=><a class="guide-card" href={guide.href}><span class="tag">{guide.tag}</span><h2>{guide.title}</h2><p>{guide.description}</p><span class="text-link">Read guide →</span></a>)}</div></div>
</BaseLayout>
